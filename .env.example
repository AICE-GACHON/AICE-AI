# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env는 git에 커밋 금지)

# OpenReview 계정 (https://openreview.net/signup 에서 무료 가입)
OPENREVIEW_USERNAME=your-email@example.com
OPENREVIEW_PASSWORD=

# Semantic Scholar API 키 (https://www.semanticscholar.org/product/api#api-key 무료 신청)
S2_API_KEY=

# Anthropic API 키 (4단계 리뷰 구조화부터 필요)
ANTHROPIC_API_KEY=
