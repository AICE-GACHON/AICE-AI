# ── LLM / Embedding API keys ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
COHERE_API_KEY=...

# ── Models (문서 확정 스택) ───────────────────────────────
ANTHROPIC_MODEL=claude-haiku-4-5
COHERE_EMBED_MODEL=embed-multilingual-v3.0
EMBED_DIM=1024

# ── Database (docker-compose 기본값과 일치) ───────────────
DATABASE_URL=postgresql+psycopg://cardrag:cardrag@localhost:5432/cardrag
